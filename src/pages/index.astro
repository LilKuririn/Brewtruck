---
import Base from '../layouts/Base.astro';
import BeertruckBackground3D from '../components/BeertruckBackground3D.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Story from '../components/Story.astro';
import Offer from '../components/Offer.astro';
import Taps from '../components/Taps.astro';
import Tasting from '../components/Tasting.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <BeertruckBackground3D />
  <Header />
  <main id="contenu">
    <Hero />
    <Marquee />
    <Story />
    <Offer />
    <Taps />
    <Tasting />
    <Quote />
  </main>
  <Footer />
</Base>
