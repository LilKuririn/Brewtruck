---
import { Image } from 'astro:assets';
import hops from '../assets/hops.jpg';

const formats = [
  { title: 'Atelier dégustation', text: 'Plusieurs bières servies côte à côte et commentées, pour découvrir les styles.' },
  { title: 'Accords mets-bières', text: 'Des bières choisies avec votre traiteur pour accompagner chaque plat.' },
  { title: 'Initiation à la biérologie', text: 'Ingrédients, brassage, service : les bases, sans jargon.' },
];

const pairings = [
  { beer: 'Blonde', color: '#E4B34C', dishes: 'Fromages frais, fritures, fruits de mer' },
  { beer: 'Ambrée', color: '#B4621E', dishes: 'Viandes grillées, comté affiné, tartes salées' },
  { beer: 'Brune', color: '#4A2614', dishes: 'Chocolat noir, desserts au café, huîtres' },
];
---

<section id="ateliers" class="section" aria-labelledby="tasting-title">
  <div class="wrap">
    <h2 id="tasting-title" class="reveal">Goûter, comprendre, accorder.</h2>
    <p class="lead reveal">
      Pendant votre événement, la dégustation devient un moment à part : on sent, on compare, on apprend à parler
      de bière.
    </p>

    <figure class="band reveal">
      <Image
        src={hops}
        alt="Cônes de houblon sur leur liane, dans une houblonnière au coucher du soleil"
        widths={[800, 1400, 2000]}
        sizes="(min-width: 1320px) 1320px, 100vw"
      />
    </figure>

    <div class="cols">
      <div>
        <h3 class="col-title">Les formats</h3>
        <ul class="formats">
          {
            formats.map((f) => (
              <li class="reveal">
                <h4>{f.title}</h4>
                <p>{f.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="col-title">Quelques accords</h3>
        <ul class="pairings">
          {
            pairings.map((p) => (
              <li class="reveal" style={`--beer: ${p.color}`}>
                <span class="beer">{p.beer}</span>
                <span class="dishes">{p.dishes}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .lead {
    margin-top: 1.25rem;
  }

  .band {
    margin: 3.5rem 0 0;
  }

  .band :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: var(--r-media);
  }

  .cols {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .col-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--muted);
  }

  .formats,
  .pairings {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  h4 {
    margin: 0;
    font: 600 1.5rem/1.15 var(--font-display);
    font-stretch: 88%;
  }

  .formats p {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  /* Chaque accord porte la robe de sa bière en filet vertical */
  .pairings li {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.25rem;
    border-left: 4px solid var(--beer);
  }

  .beer {
    font: 600 1.5rem/1.15 var(--font-display);
    font-stretch: 88%;
  }

  .dishes {
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .band :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
