---
import Icon from './Icon.astro';
import { site } from '../content';
---

<footer class="footer">
  <div class="wrap">
    <p class="mark" translate="no" aria-hidden="true">{site.name}</p>

    <div class="grid">
      <p class="slogan">{site.slogan}.</p>

      <div>
        <h2 class="title">Contact</h2>
        <ul>
          <li>
            <a href={`mailto:${site.email}`}><Icon name="envelope-simple" /><span translate="no">{site.email}</span></a>
          </li>
          <li>
            <a href={site.instagram} rel="noopener" target="_blank"><Icon name="instagram-logo" />Instagram</a>
          </li>
        </ul>
      </div>

    </div>

    <div class="legal">
      <p>L’abus d’alcool est dangereux pour la santé, à consommer avec modération.</p>
      <p>© {new Date().getFullYear()} <span translate="no">{site.name}</span></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 6rem) 2rem;
    border-top: 1px solid var(--line);
  }

  .mark {
    font: 800 clamp(4.5rem, 22.5vw, 20rem) / 0.8 var(--font-display);
    font-stretch: 75%;
    letter-spacing: -0.045em;
    color: var(--amber);
  }

  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2.5rem;
  }

  .slogan {
    font: 300 clamp(1.5rem, 2.6vw, 2.25rem) / 1.15 var(--font-display);
  }

  .title {
    font: 600 0.9375rem/1.4 var(--font-body);
    letter-spacing: 0;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  ul a:hover {
    color: var(--amber-text);
  }

  ul :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }


  .legal {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
