---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Bubbles from './Bubbles.astro';
import foam from '../assets/foam.jpg';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow in" style="--i: 0">Beertruck artisanal & zythologie</p>
    <!-- Titre révélé mot à mot : la promesse se lit au rythme d'une gorgée -->
    <h1 id="hero-title">
      <span class="w" style="--w: 0">La</span> <span class="w" style="--w: 1">bière</span>{' '}
      <strong><span class="w" style="--w: 2">à</span> <span class="w" style="--w: 3">portée</span> <span class="w" style="--w: 4">de</span> <span class="w" style="--w: 5">main.</span></strong>
    </h1>
    <p class="lead in" style="--i: 6">
      Un bar à bières mobile, deux à trois becs à la pression et des recettes brassées maison pour vos
      événements.
    </p>
    <div class="actions in" style="--i: 7">
      <a class="btn btn-primary" href="#devis">Demander un devis <Icon name="arrow-up-right" /></a>
      <a class="btn btn-ghost" href="#becs">Voir la carte</a>
    </div>
  </div>

  <!-- Le verre se remplit au chargement : le geste du service à la pression -->
  <div class="glass">
    <Image
      src={foam}
      alt="Pinte de bière blonde sous une mousse épaisse, bulles en suspension, en contre-jour"
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 40vw, 90vw"
      loading="eager"
      fetchpriority="high"
    />
    <Bubbles count={16} />
  </div>
</section>

<style>
  .hero {
    min-height: calc(100dvh - var(--header-h));
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(3.25rem, 7.4vw, 6.75rem);
    font-weight: 300;
    font-stretch: 80%;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  h1 strong {
    font-weight: 750;
    color: var(--amber-text);
  }

  .lead {
    margin-top: 1.75rem;
    max-width: 40ch;
  }

  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .glass {
    position: relative;
    aspect-ratio: 3 / 4;
    max-height: calc(100dvh - var(--header-h) - 5rem);
    width: 100%;
    justify-self: end;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 91% 100%, 9% 100%);
    background: var(--surface);
  }

  .glass :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  /* Écrans à souris (là où le fond 3D tourne) : le hero se découpe en deux étages.
     En haut le texte et la pinte, en bas une « scène » libre où le camion roule sur toute la largeur.
     La hauteur de la scène suit le cadrage caméra de beertruck-scene.ts (camion entre ~68 et 95 % de l'écran). */
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .hero {
      --stage: 34vh;
      grid-template-rows: 1fr var(--stage);
      row-gap: 0;
      padding-bottom: 0;
    }

    .copy,
    .glass {
      grid-row: 1;
    }

    /* La pinte se pose sur la ligne d'horizon de la route au lieu de descendre dessus */
    .glass {
      align-self: end;
      width: auto;
      max-width: 100%;
      height: min(calc(100dvh - var(--header-h) - var(--stage) - 5rem), 620px);
      max-height: none;
    }
  }

  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg);
    transform: translateY(-101%);
  }

  /* Les bulles s'arrêtent sous la mousse (vers la moitié du verre) */
  .glass {
    --bubbles-top: 50;
  }

  .w {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .in {
      animation: enter 0.9s var(--ease) both;
      animation-delay: calc(var(--i) * 90ms + 150ms);
    }
    .w {
      animation: word 0.9s var(--ease) both;
      animation-delay: calc(var(--w) * 80ms + 200ms);
    }
    .glass::after {
      animation: pour 1.7s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
    }
    /* Profondeur : l'image descend un peu moins vite que la page */
    @supports (animation-timeline: scroll()) {
      .glass :global(img) {
        animation: depth linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes word {
    from {
      opacity: 0;
      transform: translateY(0.45em) rotate(4deg);
    }
  }

  @keyframes depth {
    from {
      transform: scale(1.08) translateY(0);
    }
    to {
      transform: scale(1.08) translateY(6%);
    }
  }

  @keyframes pour {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-101%);
    }
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 2.5rem;
    }
    .glass {
      aspect-ratio: 4 / 3;
      max-height: none;
      clip-path: polygon(0 0, 100% 0, 94% 100%, 6% 100%);
    }
    .glass {
      --bubbles-top: 40;
    }
    .glass :global(img) {
      object-position: 60% 28%;
    }
  }
</style>
