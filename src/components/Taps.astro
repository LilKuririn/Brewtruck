---
import { taps } from '../content';
---

<section id="becs" class="section" aria-labelledby="taps-title">
  <div class="wrap">
    <p class="eyebrow reveal">La carte</p>
    <h2 id="taps-title" class="reveal">À la pression cette saison.</h2>
    <p class="lead reveal">Carte indicative : elle évolue au fil des brassins, des saisons et de votre menu.</p>

    <ol class="taps">
      {
        taps.map((t, i) => (
          <li class="tap reveal" style={`--beer: ${t.color}`}>
            <div class="glass" aria-hidden="true">
              <span class="fill" />
            </div>
            <div class="id">
              <p class="num">Bec {i + 1}</p>
              <h3>{t.name}</h3>
              <p class="origin">{t.origin}</p>
            </div>
            <dl>
              <div><dt>Style</dt><dd>{t.style}</dd></div>
              <div><dt>Robe</dt><dd>{t.colorName}</dd></div>
              <div><dt>Amertume</dt><dd>{t.bitterness}</dd></div>
            </dl>
            <p class="notes">{t.notes}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .lead {
    margin-top: 1.25rem;
  }

  h2 {
    margin-top: 1rem;
  }

  .taps {
    list-style: none;
    margin: 4rem 0 0;
    padding: 0;
  }

  .tap {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1.3fr) minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  /* Verre en trapèze, rempli de la robe de la bière, mousse au sommet */
  .glass {
    position: relative;
    height: 6.5rem;
    clip-path: polygon(0 0, 100% 0, 86% 100%, 14% 100%);
    background: var(--surface);
  }

  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #ecebe4 0 16%, var(--beer) 16%);
    transform-origin: bottom;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .fill {
        animation: pour-in linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 45%;
      }
    }
  }

  @keyframes pour-in {
    from {
      transform: scaleY(0);
    }
  }

  .num {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--amber-text);
  }

  .id h3 {
    margin-top: 0.25rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    font-stretch: 82%;
  }

  .origin {
    margin-top: 0.25rem;
    color: var(--muted);
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  dt {
    font-size: 0.875rem;
    color: var(--muted);
  }

  dd {
    margin: 0.25rem 0 0;
    font-weight: 600;
  }

  .notes {
    color: var(--muted);
  }

  @media (max-width: 999px) {
    .tap {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      align-items: start;
    }
    dl,
    .notes {
      grid-column: 2;
    }
  }

  @media (max-width: 559px) {
    .tap {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      column-gap: 1rem;
    }
    .glass {
      height: 4.75rem;
    }
    dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
